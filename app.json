{
  "expo": {
    "name": "GYM Check",
    "slug": "gym-vova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash.png",
    "backgroundColor": "#000000",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymvova.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.gymvova.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "gymvova",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/gymvova"
    }
  }
}
